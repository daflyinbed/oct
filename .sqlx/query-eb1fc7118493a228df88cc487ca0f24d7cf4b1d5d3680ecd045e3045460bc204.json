  "query": "SELECT cm.message_id AS message_id, m.parts_json AS parts_json, cm.ordering AS ordering, cm.appended_at_revision AS appended_at_revision FROM conversation_messages cm JOIN messages m ON m.id = cm.message_id WHERE cm.conversation_id = $1 AND m.role = 'tool' AND m.supersedes_message_id IS NULL ORDER BY cm.ordering ASC",
