  "db_name": "SQLite",
  "query": "SELECT r.id, r.conversation_id, r.kind, r.parent_run_id, r.root_run_id, r.parent_tool_call_id, r.status, r.execution_epoch, r.history_epoch, r.provider_id, r.model_id, r.context_window, r.agent_config_json, r.error, r.final_message_id, r.input_tokens, r.output_tokens, r.description, r.started_at, r.finished_at FROM agent_runs r JOIN agent_runs p ON r.parent_run_id = p.id AND p.conversation_id = $1 AND p.history_epoch = (SELECT history_epoch FROM conversations WHERE id = $1) WHERE r.parent_tool_call_id IN (SELECT value FROM json_each($2))",
