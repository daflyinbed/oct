  "query": "SELECT m.id, cm.conversation_id, m.role, m.parts_json, m.details_json, cm.ordering, m.provider_id, m.model_id, m.input_tokens, m.output_tokens, m.reasoning_tokens, m.supersedes_message_id, cm.appended_at_revision, cm.swapped_at_revision, m.created_at FROM conversation_messages cm JOIN messages m ON m.id = cm.message_id WHERE cm.conversation_id = $1 AND m.provider_id IS NOT NULL AND m.model_id IS NOT NULL ORDER BY cm.ordering DESC LIMIT 1",
