# Compile-time-only config, read by the sqlx macros themselves at macro
# expansion (sqlx-macros-core loads .env on its own); the binary never
# loads this file at runtime — the runtime location comes from the real
# DATABASE_URL env var or the XDG default (db::resolve_database_url).
# - SQLX_OFFLINE keeps builds on the committed .sqlx cache.
# - DATABASE_URL points `cargo sqlx prepare` at a scratch repo-root
#   database (gitignored via *.db); it never touches the real data dir.
DATABASE_URL="sqlite://oct.db"
SQLX_OFFLINE=true
